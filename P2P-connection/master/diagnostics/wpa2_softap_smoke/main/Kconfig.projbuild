menu "WPA2 SoftAP smoke-test configuration"

config ESP_WIFI_SSID
    string "Wi-Fi SSID"
    default "smart-ir-wpa2-test"

config ESP_WIFI_PASSWORD
    string "Wi-Fi password"
    default "change-me-1234"

config ESP_WIFI_CHANNEL
    int "Wi-Fi channel"
    range 1 13
    default 6

config ESP_MAX_STA_CONN
    int "Maximum station connections"
    range 1 4
    default 4

config ESP_GTK_REKEYING_ENABLE
    bool "Enable GTK rekeying"
    default y

config ESP_GTK_REKEY_INTERVAL
    int "GTK rekey interval"
    depends on ESP_GTK_REKEYING_ENABLE
    range 60 65535
    default 600

endmenu
